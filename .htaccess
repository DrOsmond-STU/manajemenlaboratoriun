# ==========================================================================
# FLMS — konfigurasi Apache untuk hosting statis
#
# Catatan: setiap direktif dibungkus <IfModule> dan sengaja dipilih yang
# kebutuhan AllowOverride-nya paling rendah, agar konfigurasi ini tidak
# berpotensi memicu Internal Server Error pada shared hosting.
# ==========================================================================

DirectoryIndex index.html

# --- Cegah daftar isi direktori -----------------------------------------
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# --- Tutup akses ke berkas internal repositori --------------------------
# Docroot diisi lewat `git reset --hard`, sehingga seluruh isi repositori
# ikut terlayani. Berkas berikut bukan bagian dari aplikasi dan sengaja
# ditutup: dokumentasi memuat daftar kelemahan purwarupa (SECURITY.md §8)
# serta prosedur operasional yang tidak perlu terbuka untuk umum.
# Dokumen tetap dapat dibaca di repositori Git.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
  RedirectMatch 404 /\.htaccess
  RedirectMatch 404 ^/docs/
  RedirectMatch 404 ^/tests/
  RedirectMatch 404 ^/package(-lock)?\.json$
  RedirectMatch 404 ^/README\.md$
  # backend/ adalah aplikasi Laravel. Tempatnya yang benar DI LUAR docroot
  # (lihat docs/BACKEND.md §6); blok ini hanya lapis kedua agar `.env`,
  # storage, dan konfigurasi tidak pernah terlayani bila sewaktu-waktu
  # direktorinya ikut tersalin ke dalam docroot.
  RedirectMatch 404 ^/backend/
</IfModule>

# --- Paksa HTTPS --------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# --- Tipe konten --------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/css                   .css
  AddType application/javascript     .js
  AddType image/svg+xml              .svg
</IfModule>

# --- Kompresi -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache --------------------------------------------------------------
# Purwarupa masih sering diperbarui: aset di-cache singkat agar perubahan
# langsung terlihat tanpa perlu hard refresh.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType image/svg+xml          "access plus 7 days"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
